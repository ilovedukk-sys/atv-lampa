# Ключ TMDB: themoviedb.org → Settings → API. Подходит «API Key» или «API Read Access Token».
# Скопируйте этот файл в .env.local и впишите ключ. .env.local не попадает в git.
VITE_TMDB_KEY=

# Если TMDB недоступен в вашей сети — адреса прокси (иначе оставьте пустыми)
VITE_TMDB_API_URL=
VITE_TMDB_IMAGE_URL=
