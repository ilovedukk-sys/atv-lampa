# Ключ TMDB: themoviedb.org → Settings → API. Подходит «API Key» или «API Read Access Token».
# Скопируйте этот файл в .env.local и впишите ключ. .env.local не попадает в git.
VITE_TMDB_KEY=

# Если TMDB недоступен в вашей сети — адреса прокси (иначе оставьте пустыми)
VITE_TMDB_API_URL=
VITE_TMDB_IMAGE_URL=

# Адрес TorrServer по умолчанию (можно поменять в «Настройках» на ТВ), например http://192.168.0.15:8090
VITE_TORRSERVER_URL=

# Парсер раздач в формате Jackett (Jackett / Prowlarr / jacred) — необязательно, тоже есть в «Настройках»
VITE_PARSER_URL=
VITE_PARSER_KEY=
